{
  "name": "znada",
  "version": "1.9.0",
  "description": "Znada — автоматическая смена обоев при переключении светлой/тёмной темы Windows. Интерфейс в стиле GNOME Adwaita.",
  "main": "main.js",
  "author": "alexv",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "build:thumbnail-helper": "node scripts/build-thumbnail-helper.js",
    "prestart": "npm run build:thumbnail-helper && npm run prepare:video",
    "start": "electron .",
    "predev:cloud": "npm run build:thumbnail-helper && npm run prepare:video",
    "dev:cloud": "set ZNADA_CLOUD=staging&& set ZNADA_DEV_USER_DATA=%LOCALAPPDATA%\\Znada-Dev&& electron .",
    "predev:diagnostics": "npm run build:thumbnail-helper && npm run prepare:video",
    "dev:diagnostics": "set ZNADA_DIAGNOSTICS=1&& set ZNADA_DIAGNOSTICS_USER_DATA=%LOCALAPPDATA%\\Znada-Diagnostics&& electron . --diagnostics",
    "pretest": "npm run build:thumbnail-helper",
    "test": "node scripts/run-tests.js",
    "test:temp": "node scripts/check-test-temp.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "lint:i18n": "node scripts/lint-i18n.js",
    "i18n:state": "node scripts/i18n-state.js report",
    "i18n:context": "node scripts/i18n-context.js report",
    "prepackage": "npm run build:thumbnail-helper && npm run prepare:video",
    "package": "node scripts/package-app.js",
    "postpackage": "node scripts/verify-thumbnail-package.js",
    "prepackage:official": "npm run build:thumbnail-helper && npm run prepare:video",
    "package:official": "set ZNADA_OFFICIAL_BUILD=1&& node scripts/package-app.js --official",
    "postpackage:official": "set ZNADA_OFFICIAL_BUILD=1&& node scripts/verify-thumbnail-package.js --official",
    "installer": "npm run package && node scripts/build-installer.js",
    "installer:official": "npm run package:official && node scripts/build-installer.js",
    "prepare:video": "node scripts/prepare-video-runtime.js"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/packager": "^20.0.0",
    "@types/node": "^26.4.0",
    "electron": "^43.2.0",
    "electron-winstaller": "^5.4.0",
    "eslint": "^9.39.5",
    "eslint-scope": "^8.4.0",
    "espree": "^10.4.0",
    "globals": "^17.11.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "koffi": "2.15.1"
  }
}
